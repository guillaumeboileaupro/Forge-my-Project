#!/bin/sh
# Genere par Forge-my-Project. Activation : git config core.hooksPath .githooks
# pre-push : typage et tests avant publication (les controles de pre-commit ne sont pas repetes).
set -eu
fail() { echo "pre-push: $1" >&2; exit 1; }
{{#each hooks.pre_push}}

echo "pre-push: {{ this.label }}"
{{ this.guard }}
{{ this.command }} || fail "{{ this.label }} en echec"
{{/each}}
exit 0
