{
  "description": "Garde-fou Forge-my-Project : refuse les contournements Git et l'ecriture de secrets.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/agent_guard.py\"",
            "timeout": 30,
            "statusMessage": "Garde-fou : controle de l'action"
          }
        ]
      }
    ]
  }
}
