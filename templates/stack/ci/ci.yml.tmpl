# Genere par Forge-my-Project. Actions officielles epinglees par SHA de commit
# (verifiees le {{ ci.verified_at }}). Mettre a jour via une PR dediee.
name: CI

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

jobs:
  quality:
    name: Qualite, tests et audit
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - name: Checkout
        uses: {{ ci.actions.checkout.repository }}@{{ ci.actions.checkout.sha }} # {{ ci.actions.checkout.tag }}
        with:
          persist-credentials: false
{{#if python}}
      - name: Python {{ python.version }}
        uses: {{ ci.actions.setup_python.repository }}@{{ ci.actions.setup_python.sha }} # {{ ci.actions.setup_python.tag }}
        with:
          python-version: "{{ python.version }}"
{{/if}}
{{#if node}}
      - name: Node.js {{ node.version }}
        uses: {{ ci.actions.setup_node.repository }}@{{ ci.actions.setup_node.sha }} # {{ ci.actions.setup_node.tag }}
        with:
          node-version: "{{ node.version }}"
{{/if}}
{{#each ci.steps}}
      - name: {{ this.name }}
        run: |
          {{ this.run }}
{{/each}}
