# Genere par Forge-my-Project. Actions officielles epinglees par SHA de commit
# (verifiees le {{ ci.verified_at }}). Mettre a jour via une PR dediee.
# Tout echec de controle bloque la CI : aucun controle n'est ignore ni rendu facultatif.
name: CI

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

jobs:
  quality:
    name: Qualite et tests
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - name: Checkout
        uses: {{ ci.actions.checkout.repository }}@{{ ci.actions.checkout.sha }} # {{ ci.actions.checkout.tag }}
        with:
          persist-credentials: false
{{#if python}}
      - name: Python {{ python.version }}
        uses: {{ ci.actions.setup_python.repository }}@{{ ci.actions.setup_python.sha }} # {{ ci.actions.setup_python.tag }}
        with:
          python-version: "{{ python.version }}"
{{/if}}
{{#if node}}
      - name: Node.js {{ node.version }}
        uses: {{ ci.actions.setup_node.repository }}@{{ ci.actions.setup_node.sha }} # {{ ci.actions.setup_node.tag }}
        with:
          node-version: "{{ node.version }}"
{{/if}}
{{#if rust}}
      - name: Rust {{ rust.version }} (rustup, preinstalle sur le runner)
        run: |
          rustup toolchain install {{ rust.version }} --profile minimal --component clippy,rustfmt
          rustup default {{ rust.version }}
{{/if}}
{{#if go}}
      - name: Go {{ go.version }}
        uses: {{ ci.actions.setup_go.repository }}@{{ ci.actions.setup_go.sha }} # {{ ci.actions.setup_go.tag }}
        with:
          go-version: "{{ go.version }}"
          cache: false
{{/if}}
{{#if java}}
      - name: Java {{ java.version }} (Temurin)
        uses: {{ ci.actions.setup_java.repository }}@{{ ci.actions.setup_java.sha }} # {{ ci.actions.setup_java.tag }}
        with:
          distribution: temurin
          java-version: "{{ java.version }}"
{{/if}}
{{#each ci.steps}}
      - name: {{ this.name }}
        run: |
{{#each this.lines}}
          {{ this }}
{{/each}}
{{/each}}
{{#if e2e.applicable}}

  e2e:
    name: Bout en bout (livrable)
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: Checkout
        uses: {{ ci.actions.checkout.repository }}@{{ ci.actions.checkout.sha }} # {{ ci.actions.checkout.tag }}
        with:
          persist-credentials: false
{{#if python}}
      - name: Python {{ python.version }}
        uses: {{ ci.actions.setup_python.repository }}@{{ ci.actions.setup_python.sha }} # {{ ci.actions.setup_python.tag }}
        with:
          python-version: "{{ python.version }}"
{{/if}}
{{#if node}}
      - name: Node.js {{ node.version }}
        uses: {{ ci.actions.setup_node.repository }}@{{ ci.actions.setup_node.sha }} # {{ ci.actions.setup_node.tag }}
        with:
          node-version: "{{ node.version }}"
{{/if}}
{{#each e2e.steps}}
      - name: {{ this.name }}
        run: |
{{#each this.lines}}
          {{ this }}
{{/each}}
{{/each}}
{{/if}}

  security:
    name: Securite (secrets, SAST, dependances, SBOM)
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - name: Checkout (historique complet pour la recherche de secrets)
        uses: {{ ci.actions.checkout.repository }}@{{ ci.actions.checkout.sha }} # {{ ci.actions.checkout.tag }}
        with:
          fetch-depth: 0
          persist-credentials: false
{{#if python}}
      - name: Python {{ python.version }}
        uses: {{ ci.actions.setup_python.repository }}@{{ ci.actions.setup_python.sha }} # {{ ci.actions.setup_python.tag }}
        with:
          python-version: "{{ python.version }}"
{{/if}}
{{#if node}}
      - name: Node.js {{ node.version }}
        uses: {{ ci.actions.setup_node.repository }}@{{ ci.actions.setup_node.sha }} # {{ ci.actions.setup_node.tag }}
        with:
          node-version: "{{ node.version }}"
{{/if}}
{{#each security.steps}}
      - name: {{ this.name }}
        run: |
{{#each this.lines}}
          {{ this }}
{{/each}}
{{/each}}
{{#if security.sboms}}
      - name: Publication des SBOM
        uses: {{ ci.actions.upload_artifact.repository }}@{{ ci.actions.upload_artifact.sha }} # {{ ci.actions.upload_artifact.tag }}
        with:
          name: sbom
          path: |
{{#each security.sboms}}
            {{ this }}
{{/each}}
          if-no-files-found: error
          retention-days: 30
{{/if}}

  attribution:
    name: Attribution Git (aucun agent IA auteur, committer ou co-auteur)
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Checkout (historique complet)
        uses: {{ ci.actions.checkout.repository }}@{{ ci.actions.checkout.sha }} # {{ ci.actions.checkout.tag }}
        with:
          fetch-depth: 0
          persist-credentials: false
      - name: Auteurs, committers, trailers et description de PR
        run: |
          python3 scripts/hooks/attribution_guard.py ci
