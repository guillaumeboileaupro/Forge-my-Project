{
  "schema_version": 1,
  "id": "scaffold-typescript",
  "description": "Manifeste npm, tsconfig strict et point d'entree TypeScript vide.",
  "priority": 35,
  "when": {
    "technologies_all": [
      "typescript",
      "node"
    ]
  },
  "files": [
    {
      "path": "package.json",
      "template": "stack/node/package.json.tmpl"
    },
    {
      "path": "tsconfig.json",
      "template": "stack/node/tsconfig.json.tmpl"
    },
    {
      "path": "src/index.ts",
      "template": "stack/node/index.tmpl"
    }
  ]
}
