{
  "schema_version": 1,
  "category": "quality",
  "technologies": [
    {
      "id": "ruff",
      "name": "Ruff",
      "description": "Linter et formateur Python.",
      "ecosystem": "pypi",
      "package": "ruff",
      "dev": true,
      "requires": [
        "python"
      ],
      "commands": {
        "lint": "ruff check .",
        "format": "ruff format --check ."
      },
      "docs": "https://docs.astral.sh/ruff/"
    },
    {
      "id": "mypy",
      "name": "mypy",
      "description": "Verificateur de types statique pour Python.",
      "ecosystem": "pypi",
      "package": "mypy",
      "dev": true,
      "requires": [
        "python"
      ],
      "commands": {
        "typecheck": "mypy"
      },
      "docs": "https://mypy.readthedocs.io/"
    },
    {
      "id": "eslint",
      "name": "ESLint",
      "description": "Linter JavaScript et TypeScript.",
      "ecosystem": "npm",
      "package": "eslint",
      "dev": true,
      "requires": [
        "node"
      ],
      "commands": {
        "lint": "npx eslint . --max-warnings 0"
      },
      "docs": "https://eslint.org/docs/latest/",
      "companions": [
        {
          "package": "@eslint/js"
        },
        {
          "package": "eslint-plugin-security"
        },
        {
          "package": "typescript-eslint",
          "when_any": [
            "typescript"
          ]
        }
      ]
    },
    {
      "id": "prettier",
      "name": "Prettier",
      "description": "Formateur de code.",
      "ecosystem": "npm",
      "package": "prettier",
      "dev": true,
      "requires": [
        "node"
      ],
      "commands": {
        "format": "npx prettier --check src tests"
      },
      "docs": "https://prettier.io/docs/"
    }
  ]
}
